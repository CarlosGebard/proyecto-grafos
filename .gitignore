# Entornos y cachés locales
.venv/
.pytest_cache/
.ruff_cache/
__pycache__/
*.pyc

# Datos y ejecuciones reproducibles
simulacion/data/prepared/
simulacion/data/downloads/
# Ejecuciones: sólo las corridas de verificación de los pilotos están versionadas;
